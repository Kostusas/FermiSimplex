@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(adaptivesimplex CONFIG)
find_dependency(LAPACK)
if(@FERMISIMPLEX_DENSITY_OPENMP_ENABLED@)
  find_dependency(OpenMP COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/fermisimplex-targets.cmake")

check_required_components(fermisimplex)
